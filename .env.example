# Chép thành .env. `npm start` KHÔNG đọc file này (local tự dùng local.db);
# chỉ `npm run start:turso` đọc nó để chạy local với DB Turso thật.
# Giá trị có ký tự đặc biệt (# $ ...) phải bọc trong nháy đơn, nếu không sẽ bị cắt mất.
TURSO_DATABASE_URL=libsql://ten-db-cua-ban.turso.io
TURSO_AUTH_TOKEN=
JWT_SECRET='doi-thanh-chuoi-ngau-nhien-dai'
